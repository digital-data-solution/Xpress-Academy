# Copy to .env.youtube-task (never commit the real file — it's gitignored).
# Used ONLY by scripts\daily_youtube_upload.ps1, the scheduled task that
# uploads one new video/day to YouTube. Kept separate from the regular
# .env on purpose: this one holds PRODUCTION database access, not local
# dev settings — isolating it means the daily automation can't
# accidentally be pointed at anything but prod, and a mistake editing
# .env for local dev work can't accidentally break the schedule.

# The DIRECT connection (port 5432), not the pooler — same rule as
# every other prod-touching command in this repo. Render -> your
# Postgres service -> Info/Connect.
DATABASE_URL=postgres://...:5432/postgres

# From your Google Cloud OAuth client + the one-time authorization —
# see apps.catalog.management.commands.attach_to_youtube's own
# docstring for how these were obtained.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
