# Copy to .env for local dev. Never commit the real .env file.

# --- Core ---------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Non-default admin path. Set this to something private before any
# deploy — see build spec §10.
DJANGO_ADMIN_URL_PATH=admin/
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------
# Leave unset locally to use SQLite automatically (see dev.py). To use
# local Postgres instead: `docker compose up -d db` then uncomment:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/xpress_academy
#
# In production (Supabase): use the DIRECT connection (port 5432) when
# running `manage.py migrate`, and the transaction-pooler connection
# (port 6543) for the running app — see build spec §3 and prod.py.
# DATABASE_URL=postgres://...:6543/postgres

# --- Redis / Celery (Phase 7) -------------------------------------
# Not needed for `manage.py runserver` or tests — dev.py runs Celery
# tasks synchronously in-process (CELERY_TASK_ALWAYS_EAGER=True).
# Only needed to actually run `celery -A config worker -B` locally.
# REDIS_URL=redis://localhost:6379/0

# --- Payments (Phase 6) ----------------------------------------------
# Test keys only until deploy — see the payments addendum. Get these
# from the Xpress Vet Paystack dashboard (shared account) in TEST mode.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_ACCOUNT_LABEL=shared_xpressvet
# PAYSTACK_WEBHOOK_ENABLED=False
# Must match wherever `manage.py runserver` is actually reachable —
# used to build the mandatory per-transaction callback_url.
SITE_URL=http://localhost:8000

# --- Email (Phase 7) ---------------------------------------------------
# Leave everything below unset and the app still works — send_email()
# just logs and no-ops. Three tiers, checked in this order:
#
# 1. RESEND_API_KEY set → real send via Resend (the eventual setup).
# RESEND_API_KEY=re_...
#
# 2. Not set, but EMAIL_HOST_USER + EMAIL_HOST_PASSWORD are → real
#    send via SMTP against that mailbox. For Gmail: turn on 2-Step
#    Verification (myaccount.google.com/security), then generate an
#    App Password at myaccount.google.com/apppasswords — use THAT as
#    EMAIL_HOST_PASSWORD, not your normal Gmail password (Google
#    blocks plain-password SMTP login). This is the fastest way to get
#    real emails (signup verification, welcome, etc.) landing in an
#    actual inbox before Resend is set up.
# EMAIL_HOST_USER=your-gmail-address@gmail.com
# EMAIL_HOST_PASSWORD=the-16-character-app-password-no-spaces
#
# 3. Neither set → log-only, nothing actually sent (current default).

# --- Operations digest (Phase 11) ---------------------------------------
# Where the daily digest and CRITICAL interrupts land. Leave unset to
# fall back to the first superuser's email — set this explicitly
# before deploy so it's not tied to whichever account happened to run
# createsuperuser first.
# OPS_ALERT_EMAIL=

# --- Media / video (wired in Phase 2+) --------------------------------
# CLOUDINARY_URL=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
