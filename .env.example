# Copy to .env for local dev. Never commit the real .env file.

# --- Core ---------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-value
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Non-default admin path. Set this to something private before any
# deploy — see build spec §10.
DJANGO_ADMIN_URL_PATH=admin/
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------
# Leave unset locally to use SQLite automatically (see dev.py). To use
# local Postgres instead: `docker compose up -d db` then uncomment:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/xpress_academy
#
# In production (Supabase): use the DIRECT connection (port 5432) when
# running `manage.py migrate`, and the transaction-pooler connection
# (port 6543) for the running app — see build spec §3 and prod.py.
# DATABASE_URL=postgres://...:6543/postgres

# --- Redis / Celery (wired in Phase 7) -------------------------------
# REDIS_URL=redis://localhost:6379/0

# --- Payments (Phase 6) ----------------------------------------------
# Test keys only until deploy — see the payments addendum. Get these
# from the Xpress Vet Paystack dashboard (shared account) in TEST mode.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_PUBLIC_KEY=pk_test_...
# PAYSTACK_ACCOUNT_LABEL=shared_xpressvet
# PAYSTACK_WEBHOOK_ENABLED=False
# Must match wherever `manage.py runserver` is actually reachable —
# used to build the mandatory per-transaction callback_url.
SITE_URL=http://localhost:8000

# --- Email (wired in Phase 7) -----------------------------------------
# RESEND_API_KEY=

# --- Media / video (wired in Phase 2+) --------------------------------
# CLOUDINARY_URL=
# BUNNY_STREAM_LIBRARY_ID=
# BUNNY_STREAM_API_KEY=
